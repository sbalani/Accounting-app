# Public values are embedded in client JavaScript during image build; set matching
# build args and runtime values. Replace placeholders only in private deployment config.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_APP_URL=https://accounting.example.invalid

# Server-only optional paid integrations; leave unset to disable paid requests.
# OPENAI_API_KEY=
